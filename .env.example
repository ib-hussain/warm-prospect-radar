# Flask
FLASK_SECRET_KEY=change-me-before-deployment
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=true

# Docker-only host-side options
RADAR_PORT=5000
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Storage: auto chooses Supabase when both credentials are present, otherwise local.
DATA_BACKEND=auto
STORAGE_PATH=fileStorage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
# Legacy compatibility name; leave blank when SUPABASE_SECRET_KEY is used.
SUPABASE_KEY=
SUPABASE_BUCKET=business-snapshots
SUPABASE_UPLOAD_RAW=false

# Website acquisition
SCRAPER_USER_AGENT=WarmProspectRadar/0.1 (+contact@example.com)
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGES=12
SCRAPER_MAX_DEPTH=2
SCRAPER_DELAY_SECONDS=0.15
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_JS_FALLBACK=true
PLAYWRIGHT_EXECUTABLE_PATH=
SCRAPER_VERIFY_TLS=true
ALLOW_PUBLIC_SOCIAL_FALLBACK=true
SCRAPER_SOCIAL_PROFILE_LIMIT=4

# Local LLM first, Together AI second.
ENABLE_LLM=true
LLM_PROVIDER_ORDER=ollama,together
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo
LLM_TIMEOUT_SECONDS=75

# Default central feature controls. The first database/local record is seeded
# from these values and can then be changed from the Settings page.
ENABLE_ACQUISITION=true
ENABLE_SOCIAL_ACQUISITION=true
ENABLE_OUTREACH=true
ENABLE_CHATBOT=true
ENABLE_SCHEDULED_REFRESH=true
ENABLE_EXTERNAL_DELIVERY=true

# Daily refresh. In Docker, SCHEDULER_RUN_IN_WEB=true runs it in the one-worker app.
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_INITIAL_DELAY_SECONDS=60
SCHEDULER_MAX_BUSINESSES_PER_RUN=100
SCHEDULER_RUN_IN_WEB=false

# Grounded assistant context limits
ASSISTANT_MAX_BUSINESSES=20
ASSISTANT_CONTEXT_CHARACTERS=24000

# Outreach delivery. dry_run is the safe default and sends nothing externally.
# live email uses SMTP; live non-email channels use the authorised webhook.
OUTREACH_DELIVERY_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
OUTREACH_WEBHOOK_URL=
OUTREACH_WEBHOOK_SECRET=

# Optional official social acquisition tokens
META_ACCESS_TOKEN=
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202501
GITHUB_TOKEN=
